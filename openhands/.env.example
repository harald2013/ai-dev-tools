# Copy to .env (same folder as compose.yml) if your Linux host user's
# UID/GID isn't 1000, so files written under ./.openhands stay owned by you.
# Not needed on Windows/Docker Desktop or if your UID/GID is already 1000.
#
#   cp .env.example .env && sed -i "1s/1000/$(id -u)/;2s/1000/$(id -g)/" .env
#
OPENHANDS_UID=1000
OPENHANDS_GID=1000
